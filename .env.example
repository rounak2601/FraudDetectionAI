# Local host-based development. Copy to .env and change secrets as needed.
POSTGRES_HOST_PORT=5433
POSTGRES_DB=fraud_db
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass
POSTGRES_URL=postgresql://fraud_user:fraud_pass@127.0.0.1:5433/fraud_db

REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
KAFKA_PORT=9092
KAFKA_BROKER=127.0.0.1:9092
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_local

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_REQUIRED=false
MODEL_FRAUD_THRESHOLD=0.5
INLINE_EXPLANATIONS=false

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REACT_APP_API_URL=http://localhost:8000
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=change_me_local

ALLOW_ENCODER_FALLBACK=false
